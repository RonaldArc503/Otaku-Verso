---
import '@fontsource-variable/manrope';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
import Icon from '../components/Icon.astro';
interface Props { title?: string; description?: string; }
const { title = 'Otaku Verso — Tu próximo universo empieza aquí', description = 'Descarga la app oficial de Otaku Verso para Android. Explora anime y manga, guarda tus favoritos y continúa donde lo dejaste.' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101014" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/social.webp', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a href="#contenido" class="skip-link">Saltar al contenido</a>
    <header class="header shell">
      <a class="brand" href="/" aria-label="Otaku Verso, inicio"><img src="/logo.png" width="44" height="44" alt="" /><span>otaku<span class="brand-light">verso</span><span class="brand-dot">.</span></span></a>
      <nav aria-label="Navegación principal"><a href="/#universo">La app</a><a href="/#instalar">Cómo instalar</a><a href="/#preguntas">Preguntas</a></nav>
      <a class="nav-download" href="/#descargar">Descargar <Icon name="arrow" size={16} /></a>
    </header>
    <slot />
    <footer class="footer shell">
      <div class="footer-top"><a class="brand" href="/"><img src="/logo.png" width="40" height="40" alt="" /><span>otaku<span class="brand-light">verso</span><span class="brand-dot">.</span></span></a><p>Un universo para quienes viven las historias.</p><a class="footer-contact" href="mailto:animerc503@gmail.com">Hablemos <Icon name="arrow" size={16} /></a></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Otaku Verso · DEV Alex</span><div><a href="/terminos">Términos</a><a href="/privacidad">Privacidad</a><button type="button" id="privacy-settings">Preferencias de privacidad</button></div><span class="made-for">Hecho para fans <span aria-hidden="true">✳</span></span></div>
    </footer>
    <aside class="consent" id="consent" aria-label="Preferencias de estadísticas" hidden>
      <div><strong>Tu universo, tus decisiones.</strong><p>Usamos almacenamiento necesario. Con tu permiso, activamos Google Analytics para entender cómo se utiliza la web. <a href="/privacidad">Más información</a></p></div><div class="consent-actions"><button type="button" id="consent-no">Solo necesarias</button><button type="button" id="consent-yes">Permitir estadísticas</button></div>
    </aside>
    <script>
      import '../scripts/privacy';
    </script>
  </body>
</html>
